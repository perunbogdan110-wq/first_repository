        "import time\n",
        "import random\n",
        "\n",
        "def play():\n",
        "    q=3\n",
        "    while True:\n",
        "        a=random.randint(1, 100)\n",
        "        b=random.randint(1, 100)\n",
        "        c=int(input(f'Новый пример: {a} + {b}?\\nВведите ответ: '))\n",
        "        if c!=a+b:\n",
        "            print(f'Неверно! Штрафная пауза: {q} секунд')\n",
        "            time.sleep(q)\n",
        "            q+=1\n",
        "\n",
        "        else:\n",
        "                return 'Поздравляю! Ваш ответ правильный'\n",
        "                break"
